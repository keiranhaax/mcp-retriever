{
	"name": "mcp-retriever",
	"version": "0.0.24",
	"description": "MCP server for multi-provider web search and content retrieval",
	"keywords": [
		"ai",
		"brave-search",
		"content-enrichment",
		"content-processing",
		"data-extraction",
		"fact-verification",
		"firecrawl",
		"image-captioning",
		"llm",
		"mcp",
		"model-context-protocol",
		"multi-provider",
		"pdf-processing",
		"search",
		"site-mapping",
		"summarization",
		"tavily",
		"unified-search",
		"url-reader",
		"web-crawling",
		"web-interactions",
		"web-search"
	],
	"homepage": "https://github.com/keiranhaax/mcp-retriever#readme",
	"bugs": {
		"url": "https://github.com/keiranhaax/mcp-retriever/issues"
	},
	"license": "MIT",
	"author": "keiranhaax",
	"contributors": [
		"Scott Spence (original author of mcp-omnisearch)"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/keiranhaax/mcp-retriever.git"
	},
	"bin": {
		"mcp-retriever": "./dist/index.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"main": "dist/index.js",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/",
		"tag": "latest"
	},
	"scripts": {
		"build": "vp pack",
		"dev": "vp pack --watch",
		"start": "node ./dist/index.js",
		"check": "vp check",
		"check:fix": "vp check --fix",
		"format": "vp check --fix",
		"test": "vp test",
		"test:watch": "vp test watch",
		"test:smoke": "node scripts/smoke-mcp.mjs",
		"changeset": "changeset",
		"version": "changeset version",
		"release": "pnpm run build && changeset publish",
		"sync-server-json": "node -e \"const pkg = require('./package.json'); const server = require('./server.json'); server.version = pkg.version; server.packages[0].version = pkg.version; require('fs').writeFileSync('./server.json', JSON.stringify(server, null, 2));\"",
		"publish-mcp": "pnpm run sync-server-json && mcp-publisher publish"
	},
	"dependencies": {
		"@tmcp/adapter-valibot": "^0.1.6",
		"@tmcp/transport-stdio": "^0.4.3",
		"mcp-proxy": "6.7.3",
		"octokit": "^5.0.5",
		"tmcp": "^1.19.4",
		"valibot": "^1.4.2"
	},
	"devDependencies": {
		"@changesets/cli": "^2.31.0",
		"@types/node": "^25.9.4",
		"vite-plus": "^0.2.0",
		"vitest": "^4.1.11"
	},
	"bundleDependencies": [
		"@tmcp/adapter-valibot",
		"@tmcp/transport-stdio",
		"mcp-proxy",
		"octokit",
		"tmcp",
		"valibot"
	],
	"engines": {
		"node": ">=22.0.0"
	},
	"packageManager": "pnpm@11.9.0",
	"mcpName": "io.github.keiranhaax/mcp-retriever"
}
